root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.{ps1,psm1}]
# PowerShell 5.1 按 ANSI 读取脚本，正文保持 ASCII 最稳
charset = utf-8

[*.java]
indent_size = 4
